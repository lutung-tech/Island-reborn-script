-- Dragging GUI
do
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = frame.Position
        end
    end)
    table.insert(uiConnections, UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(uiConnections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

gui.Destroying:Connect(function()
    running = false 
    runId = runId + 1
    for _, c in ipairs(uiConnections) do c:Disconnect() end
end)

-- ===== Simulator Tap Layar =====
local function insideFrame(x, y)
    local p, s = frame.AbsolutePosition, frame.AbsoluteSize
    return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function tapScreen()
    local cam = workspace.CurrentCamera
    local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
    
    local tx, ty = vs.X * 0.5, vs.Y * 0.5
    if insideFrame(tx, ty) then
        tx = vs.X * 0.5
        ty = vs.Y * 0.25
    end

    local touchId = 9
    pcall(function()
        VIM:SendTouchEvent(touchId, 0, tx, ty) 
        task.wait(clickDelay)
        VIM:SendTouchEvent(touchId, 2, tx, ty) 
    end)
end

-- Mencari objek pelampung di workspace
local function findBobber()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("bobber") or name:find("float") or name:find("hook") then
                return obj
            end
        end
    end
    return nil
end

-- ===== Loop Utama v28 =====
local function fishingLoop(myRun)
    while isActive(myRun) do
        status.Text = "Status: Melempar Kail..."
        tapScreen() -- Lempar pancingan
        
        status.Text = "Status: Mencari Pelampung..."
        local bobber = nil
        local startFind = os.clock()
        
        -- Tunggu sampai pelampung muncul di air
        while isActive(myRun) and (os.clock() - startFind < 6) do
            bobber = findBobber()
            if bobber then break end
            task.wait(0.1)
        end
        
        if not isActive(myRun) then break end
        
        if not bobber then
            status.Text = "Status: Pelampung Hilang, Ulang..."
            task.wait(1)
            continue
        end
        
        status.Text = "Status: Memantau Pelampung..."
        local biteStart = os.clock()
        local hooked = false
        
        -- Beri jeda 1 detik agar pelampung stabil di permukaan air
        task.wait(1.0)
        if not bobber.Parent then continue end
        local initialY = bobber.Position.Y
        
        -- Pantau penurunan posisi Y secara real-time
        while isActive(myRun) and bobber.Parent and (os.clock() - biteStart < maxWaitTime) do
            local currentY = bobber.Position.Y
            -- Jika pelampung turun ke bawah melewati batas sinkLimit
            if (initialY - currentY) >= sinkLimit then
                hooked = true
                break
            end
            task.wait(0.03)
        end
        
        if not isActive(myRun) then break end
        
        if hooked then
            status.Text = "Status: STRIKE! Pelampung Tarik!"
        else
            status.Text = "Status: Timeout, Menarik Kail..."
        end
        
        tapScreen() -- Tarik pancingan
        task.wait(postReelWait)
    end
    
    if runId == myRun then
        status.Text = "Status: OFF"
    end
end

-- ===== Tombol Kontrol =====
startButton.MouseButton1Click:Connect(function()
    if running then return end
    runId = runId + 1
    running = true
    status.Text = "Status: Berjalan"
    task.spawn(fishingLoop, runId)
end)

