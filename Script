local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local running = false
local gui

local function click()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function getBobberFolder()
    return workspace:FindFirstChild("FishingBobbers")
end

local function hasTugSignal(obj)
    local ok, value = pcall(function()
        return obj:GetAttribute("Tug")
    end)
    return ok and value ~= nil
end

local function findBobber()
    local folder = getBobberFolder()
    if not folder then
        return nil
    end

    -- Prefer objects that already expose the Tug attribute.
    for _, obj in ipairs(folder:GetDescendants()) do
        if hasTugSignal(obj) then
            return obj
        end
    end

    -- Fallback: find a bobber-named part/model.
    for _, obj in ipairs(folder:GetDescendants()) do
        if string.find(string.lower(obj.Name), "bobber", 1, true) then
            return obj
        end
    end

    return nil
end

local function getTugValue(obj)
    local current = obj
    while current do
        local ok, value = pcall(function()
            return current:GetAttribute("Tug")
        end)
        if ok and value ~= nil then
            return value
        end
        current = current.Parent
    end
    return nil
end

local function tugIsActive(value)
    if value == true then
        return true
    end
    if type(value) == "number" and value > 0 then
        return true
    end
    if type(value) == "string" then
        local lower = string.lower(value)
        return lower == "true" or lower == "tug" or lower == "bite"
    end
    return false
end

local function setStatus(label, message)
    if label and label.Parent then
        label.Text = "Status: " .. message
    end
end

local function makeGui()
    local parent
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok then parent = result end
    end
    parent = parent or game:GetService("CoreGui")

    local screen = Instance.new("ScreenGui")
    screen.Name = "IslandRebornAutoFish"
    screen.ResetOnSpawn = false
    screen.Parent = parent

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(220, 125)
    frame.Position = UDim2.new(0.5, -110, 0.5, -62)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BorderSizePixel = 0
    frame.Parent = screen

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 30)
    title.BackgroundTransparency = 1
    title.Text = "ISLAND REBORN - AUTO FISH"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.TextSize = 13
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    local status = Instance.new("TextLabel")
    status.Position = UDim2.fromOffset(8, 34)
    status.Size = UDim2.new(1, -16, 0, 25)
    status.BackgroundTransparency = 1
    status.Text = "Status: Idle"
    status.TextColor3 = Color3.fromRGB(220, 220, 220)
    status.TextSize = 12
    status.Font = Enum.Font.Gotham
    status.Parent = frame

    local startButton = Instance.new("TextButton")
    startButton.Position = UDim2.fromOffset(10, 68)
    startButton.Size = UDim2.fromOffset(95, 35)
    startButton.Text = "START"
    startButton.TextColor3 = Color3.new(1, 1, 1)
    startButton.BackgroundColor3 = Color3.fromRGB(35, 145, 75)
    startButton.Font = Enum.Font.GothamBold
    startButton.TextSize = 13
    startButton.Parent = frame

    local stopButton = Instance.new("TextButton")
    stopButton.Position = UDim2.fromOffset(115, 68)
    stopButton.Size = UDim2.fromOffset(95, 35)
    stopButton.Text = "STOP"
    stopButton.TextColor3 = Color3.new(1, 1, 1)
    stopButton.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
    stopButton.Font = Enum.Font.GothamBold
    stopButton.TextSize = 13
    stopButton.Parent = frame

    startButton.MouseButton1Click:Connect(function()
        running = true
        setStatus(status, "Starting...")
    end)

    stopButton.MouseButton1Click:Connect(function()
        running = false
        setStatus(status, "Stopped")
    end)

    gui = screen
    return status
end

local statusLabel = makeGui()

task.spawn(function()
    while true do
        if not running then
            task.wait(0.2)
        else
            setStatus(statusLabel, "Looking for bobber...")

            local bobber = findBobber()
            local startedAt = os.clock()

            while running and not bobber and os.clock() - startedAt < 20 do
                task.wait(0.08)
                bobber = findBobber()
            end

            if not running then
                continue
            end

            if not bobber then
                setStatus(statusLabel, "Bobber not found - retrying")
                task.wait(0.5)
                continue
            end

            setStatus(statusLabel, "Waiting for fish...")
            local reeled = false
            local watchStarted = os.clock()

            while running and bobber.Parent and os.clock() - watchStarted < 90 do
                local tugValue = getTugValue(bobber)

                if tugIsActive(tugValue) then
                    setStatus(statusLabel, "Tug detected! Reeling...")
                    click()
                    reeled = true
                    break
                end

                -- Check all descendants too, in case Tug is stored on a child.
                for _, child in ipairs(bobber:GetDescendants()) do
                    if tugIsActive(getTugValue(child)) then
                        setStatus(statusLabel, "Tug detected! Reeling...")
                        click()
                        reeled = true
                        break
                    end
                end

                if reeled then break end
                task.wait(0.03)
            end

            if not running then
                continue
            end

            if not reeled then
                setStatus(statusLabel, "No tug detected - checking again")
            else
                setStatus(statusLabel, "Reeled in - waiting...")
            end

            local waitStarted = os.clock()
            while running and bobber.Parent and os.clock() - waitStarted < 8 do
                task.wait(0.08)
            end

            if running then
                task.wait(0.2)
                setStatus(statusLabel, "Ready for next cast")
            end
        end
    end
end)

print("[AutoFish] Loaded. Press START in the GUI.")
