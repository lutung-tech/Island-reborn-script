local castTimeout = 10         -- Toleransi waktu tunggu kail muncul
local biteTimeout = 45         -- Maksimal tunggu ikan menyambar
local settleDelay = 3.5        -- Jeda awal agar kail stabil di air
local moveThreshold = 3.5      -- Batas pergeseran kail saat ditarik ikan
local postReelWait = 2.0       -- Jeda setelah narik ikan sebelum lempar lagi

