-- Dragging GUI supaya bisa digeser-geser di layar HP
do
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = frame.Position
        end
    end)
    table.insert(uiConnections, UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(uiConnections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

gui.Destroying:Connect(function()
    running = false 
    runId = runId + 1
    for _, c in ipairs(uiConnections) do c:Disconnect() end
end)

-- ===== Simulator Tap Layar (Khusus HP) =====
local function insideFrame(x, y)
    local p, s = frame.AbsolutePosition, frame.AbsoluteSize
    return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function tapScreen()
    local cam = workspace.CurrentCamera
    local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
    
    local tx, ty = vs.X * 0.5, vs.Y * 0.5
    if insideFrame(tx, ty) then
        tx = vs.X * 0.5
        ty = vs.Y * 0.25
    end

    local touchId = 9
    pcall(function()
        VIM:SendTouchEvent(touchId, 0, tx, ty) 
        task.wait(clickDelay)
        VIM:SendTouchEvent(touchId, 2, tx, ty) 
    end)
end

-- Cari folder bobber pemain di workspace
local function getBobberFolder()
    return workspace:FindFirstChild("FishingBobbers")
end

local function findMyBobber()
    local folder = getBobberFolder()
    if not folder then return nil end
    
    for _, obj in ipairs(folder:GetChildren()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            return obj
        end
    end
    return nil
end

-- ===== Loop Utama Mancing =====
local function fishingLoop(myRun)
    while isActive(myRun) do
        status.Text = "Status: Melempar Kail..."
        tapScreen()
        
        status.Text = "Status: Menunggu Kail Muncul..."
        local bobber = nil
        local startWait = os.clock()
        
        while isActive(myRun) and (os.clock() - startWait < castTimeout) do
            bobber = findMyBobber()
            if bobber then break end
            task.wait(0.1)
        end
        
        if not isActive(myRun) then break end
        
        if not bobber then
            status.Text = "Status: Memantau Ikan Langsung..."
        else
            status.Text = "Status: Menunggu Kail Stabil..."
            local settleStart = os.clock()
            while isActive(myRun) and (os.clock() - settleStart < settleDelay) do
                task.wait(0.05)
            end
        end
        
        if not isActive(myRun) then break end
        
        status.Text = "Status: Menunggu Ikan Menyambar..."
        
        local fishBited = false
        local connection = nil
        local initialPos = nil
        
        if bobber and bobber.Parent then
            if bobber:IsA("BasePart") then
                initialPos = bobber.Position
            elseif bobber:IsA("Model") and bobber.PrimaryPart then
                initialPos = bobber.PrimaryPart.Position
            end
            
            -- Pantau atribut Tug dari server game
            connection = bobber.AttributeChanged:Connect(function(attrName)
                if attrName:lower() == "tug" then
                    local val = bobber:GetAttribute(attrName)
                    if val == true or (typeof(val) == "number" and val > 0) then
                        fishBited = true
                    end
                end
            end)
        end
        
        local biteStart = os.clock()
        while isActive(myRun) and not fishBited and (os.clock() - biteStart < biteTimeout) do
            if bobber and not bobber.Parent then break end
            
            if bobber and bobber:GetAttribute("Tug") == true then
                fishBited = true
                break
            end
            
            if initialPos and bobber and bobber.Parent then
                local currentPos = nil
                if bobber:IsA("BasePart") then
                    currentPos = bobber.Position
                elseif bobber:IsA("Model") and bobber.PrimaryPart then
                    currentPos = bobber.PrimaryPart.Position
                end
                
                -- Deteksi pergeseran kail saat ikan menyambar
                if currentPos and (currentPos - initialPos).Magnitude > moveThreshold then
                    fishBited = true
                    break
                end
            end
            
            task.wait(0.05)
        end
        
        if connection then connection:Disconnect() end
        
        if not isActive(myRun) then break end
        
        if fishBited then
            status.Text = "Status: STRIKE! Narik Ikan..."
        else
            status.Text = "Status: Timeout, Menarik Kail..."
        end
        
        tapScreen() 
        task.wait(postReelWait) 
    end
    
    if runId == myRun then
        status.Text = "Status: OFF"
    end
end

-- ===== Tombol Kontrol =====
startButton.MouseButton1Click:Connect(function()
    if running then return end
    runId = runId + 1
    running = true
    status.Text = "Status: Starting..."
    task.spawn(fishingLoop, runId)
end)

stopButton.MouseButton1Click:Connect(function()
    running = false
    runId = runId + 1
    status.Text = "Status: STOPPED"
end)
