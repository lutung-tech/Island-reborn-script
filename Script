-- Roblox Islands - Simple Auto Farm Slime Example
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local autoFarm = true -- Ubah ke false untuk mematikan

local function getClosestSlime()
    local closestSlime = nil
    local shortestDistance = math.huge
    
    -- Mencari folder Mobs / Wild Mobs di Workspace
    local mobsFolder = Workspace:FindFirstChild("WildMobs") or Workspace:FindFirstChild("Mobs")
    
    if mobsFolder then
        for _, mob in pairs(mobsFolder:GetChildren()) do
            if string.find(string.lower(mob.Name), "slime") and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") then
                if mob.Humanoid.Health > 0 then
                    local distance = (LocalPlayer.Character.HumanoidRootPart.Position - mob.HumanoidRootPart.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestSlime = mob
                    end
                end
            end
        end
    end
    return closestSlime
end

-- Main Loop Auto Farm
task.spawn(function()
    while autoFarm do
        task.wait(0.1)
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local target = getClosestSlime()
                if target then
                    -- Teleport di atas slime agar aman
                    LocalPlayer.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
                    
                    -- Mengayunkan/mengaktifkan senjata yang dipegang
                    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end
                end
            end
        end)
    end
end)
