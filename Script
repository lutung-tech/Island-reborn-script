-- Dragging GUI
do
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = frame.Position
        end
    end)
    table.insert(uiConnections, UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(uiConnections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

gui.Destroying:Connect(function()
    running = false 
    runId = runId + 1
    for _, c in ipairs(uiConnections) do c:Disconnect() end
end)

-- ===== Simulator Tap Layar HP =====
local function insideFrame(x, y)
    local p, s = frame.AbsolutePosition, frame.AbsoluteSize
    return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function tapScreen()
    local cam = workspace.CurrentCamera
    local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
    
    local tx, ty = vs.X * 0.5, vs.Y * 0.5
    if insideFrame(tx, ty) then
        tx = vs.X * 0.5
        ty = vs.Y * 0.25
    end

    local touchId = 9
    pcall(function()
        VIM:SendTouchEvent(touchId, 0, tx, ty) 
        task.wait(clickDelay)
        VIM:SendTouchEvent(touchId, 2, tx, ty) 
    end)
end

-- Mencari part pelampung di dalam game
local function findBobberPart()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("bobber") or name:find("float") or name:find("hook") then
                return obj
            end
        end
    end
    return nil
end

-- ===== Loop Utama Pemantauan Pelampung Amblas =====
local function fishingLoop(myRun)
    while isActive(myRun) do
        status.Text = "Status: Melempar Kail..."
        tapScreen()
        
        status.Text = "Status: Mencari Pelampung..."
        local bobber = nil
        local startWait = os.clock()
        
        -- Tunggu pelampung muncul di air
        while isActive(myRun) and (os.clock() - startWait < 8) do
            bobber = findBobberPart()
            if bobber then break end
            task.wait(0.1)
        end
        
        if not isActive(myRun) then break end
        
        if not bobber then
            status.Text = "Status: Pelampung Tidak Ketemu, Mengulang..."
            task.wait(1)
            continue
        end
        
        status.Text = "Status: Menunggu Pelampung Tertarik..."
        local biteStart = os.clock()
        local fishBited = false
        
        -- Catat posisi awal tinggi (sumbu Y) pelampung saat sudah stabil di air
        task.wait(1.5) -- Beri jeda agar pelampung benar-benar diam di permukaan air
        local initialY = bobber.Position.Y
        
        -- Pantau pergerakan turun secara real-time
        while isActive(myRun) and bobber.Parent and (os.clock() - biteStart < maxWaitTime) do
            local currentY = bobber.Position.Y
            
            -- Jika posisi Y pelampung turun melewati batas sinkThreshold (artinya amblas ke bawah)
            if (initialY - currentY) >= sinkThreshold then
                fishBited = true
                break
            end
            
            task.wait(0.04)
        end
        
        if not isActive(myRun) then break end
        
        if fishBited then
            status.Text = "Status: STRIKE! Pelampung Amblas!"
        else
            status.Text = "Status: Timeout, Menarik Kail..."
        end
        
        tapScreen() -- Langsung tarik kail pas pelampung ketarik ke bawah
        task.wait(postReelWait)
    end
    
    if runId == myRun then
        status.Text = "Status: OFF"
    end
end

-- ===== Tombol Kontrol =====
startButton.MouseButton1Click:Connect(function()
    if running then return end
    runId = runId + 1
    running = true
    status.Text = "Status: Starting..."
    task.spawn(fishingLoop, runId)
end)

stopButton.MouseButton1Click:Connect(function()
    running = false
    runId = runId + 1
    status.Text = "Status: STOPPED"
end)
