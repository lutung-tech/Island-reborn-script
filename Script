-- ===== Klik =====
local function insideFrame(x, y)
    local p, s = frame.AbsolutePosition, frame.AbsoluteSize
    return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local touchOnly = UIS.TouchEnabled and not UIS.MouseEnabled

local function getClickPos()
    local mouse = UIS:GetMouseLocation()
    if not touchOnly and not insideFrame(mouse.X, mouse.Y) then
        return mouse.X, mouse.Y
    end

    local cam = workspace.CurrentCamera
    local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
    local candidates = {
        Vector2.new(vs.X * 0.5, vs.Y * 0.5),
        Vector2.new(vs.X * 0.7, vs.Y * 0.5),
        Vector2.new(vs.X * 0.5, vs.Y * 0.3),
        Vector2.new(vs.X * 0.3, vs.Y * 0.5),
        Vector2.new(vs.X * 0.5, vs.Y * 0.7),
    }

    for _, c in ipairs(candidates) do
        if not insideFrame(c.X, c.Y) then
            return c.X, c.Y
        end
    end

    return mouse.X, mouse.Y
end

local CLICK_MODES = { "auto", "touch", "mouse", "tool" }
local clickMode = "auto"

local function sendMouse(x, y)
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(clickDelay)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function sendTouch(x, y)
    local touchId = 7
    VIM:SendTouchEvent(touchId, 0, x, y)
    task.wait(clickDelay)
    VIM:SendTouchEvent(touchId, 2, x, y)
end

local function activateTool()
    local char = player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then
        return false
    end
    tool:Activate()
    task.wait(clickDelay)
    return true
end

local function click()
    local mode = clickMode
    if mode == "auto" then
        mode = touchOnly and "touch" or "mouse"
    end

    if mode == "tool" then
        if activateTool() then
            return
        end
        mode = touchOnly and "touch" or "mouse"
    end

    local x, y = getClickPos()

    if mode == "touch" then
        local ok = pcall(sendTouch, x, y)
        if ok then
            return
        end
    end

    sendMouse(x, y)
end

-- ===== Bobber =====
local function getFolder()
    return workspace:FindFirstChild("FishingBobbers")
end

local OWNER_KEYS = { "Owner", "OwnerId", "OwnerUserId", "OwnerName", "Player", "PlayerName", "UserId" }

local function ownerCheck(inst)
    for _, key in ipairs(OWNER_KEYS) do
        local v = inst:GetAttribute(key)
        if v ~= nil then
            return v == player.Name or tostring(v) == tostring(player.UserId)
        end
    end

    for _, key in ipairs(OWNER_KEYS) do
        local child = inst:FindFirstChild(key)
        if child then
            if child:IsA("ObjectValue") then
                return child.Value == player
            elseif child:IsA("StringValue") then
                return child.Value == player.Name
            elseif child:IsA("IntValue") or child:IsA("NumberValue") then
                return child.Value == player.UserId
            end
        end
    end

    return nil
end

local function isMyBobber(obj, folder)
    local myName = player.Name:lower()
    local cur = obj

    while cur and cur ~= folder and cur ~= workspace do
        local r = ownerCheck(cur)
        if r ~= nil then
            return r
        end

        local lname = cur.Name:lower()
        if lname:find(myName, 1, true) then
            return true
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and lname:find(p.Name:lower(), 1, true) then
                return false
            end
        end

        cur = cur.Parent
    end

    return true
end

local function findBobber()
    local folder = getFolder()
    if not folder then return nil end

    for _, obj in ipairs(folder:GetDescendants()) do
        local hasTug = obj:GetAttribute("Tug") ~= nil
        local isBobberPart = obj:IsA("BasePart")
            and obj.Name:lower():find("bobber", 1, true) ~= nil

        if (hasTug or isBobberPart) and (not CHECK_OWNER or isMyBobber(obj, folder)) then
            return obj
        end
    end

    return nil
end

local function waitForBobber(id)
    local start = os.clock()

    while isActive(id) and os.clock() - start < bobberTimeout do
        local bobber = findBobber()
        if bobber then
            return bobber
        end
        task.wait(0.1)
    end

    return nil
end

local function isTugging(value)
    if value == true then
        return true
    end

    if typeof(value) == "number" and value > 0 then
        return true
    end

    return false
end

-- ===== Posisi & ikan =====
local function getPos(obj)
    if obj:IsA("BasePart") then
        return obj.Position
    end
    if obj:IsA("Model") then
        local ok, pos = pcall(function()
            return obj:GetPivot().Position
        end)
        if ok then
            return pos
        end
    end
    return nil
end

local function looksLikeFish(inst)
    local n = inst.Name:lower()

    for _, bad in ipairs(FISH_EXCLUDE) do
        if n:find(bad, 1, true) then
            return false
        end
    end

    for _, k in ipairs(FISH_KEYWORDS) do
        if n:find(k, 1, true) then
            return true
        end
    end

    return false
end

local function isInsideAnyCharacter(inst)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and inst:IsDescendantOf(p.Character) then
            return true
        end
    end
    return false
end

local fishCache, fishCacheAt = {}, 0

local function getFishCandidates(folder)
    if os.clock() - fishCacheAt > 2 then
        fishCacheAt = os.clock()
        fishCache = {}

        for _, inst in ipairs(workspace:GetDescendants()) do
            if (inst:IsA("BasePart") or inst:IsA("Model")) and looksLikeFish(inst) then
                local inFolder = folder and inst:IsDescendantOf(folder)
                if not inFolder and not isInsideAnyCharacter(inst) then
                    table.insert(fishCache, inst)
                end
            end
        end
    end

    return fishCache
end

local function nearestFish(bobber, folder)
    local bpos = getPos(bobber)
    if not bpos then return nil, nil end

    local best, bestDist
    for _, f in ipairs(getFishCandidates(folder)) do
        if f.Parent then
            local fpos = getPos(f)
            if fpos then
                local d = (fpos - bpos).Magnitude
                if not bestDist or d < bestDist then
                    best, bestDist = f, d
                end
            end
        end
    end

    return best, bestDist
end

-- ===== Loop utama =====
local function fishingLoop(myRun)
    while isActive(myRun) do
        status.Text = "Status: Casting..."
        click()

        status.Text = "Status: Searching Bobber..."
        local bobber = waitForBobber(myRun)

        if not isActive(myRun) then break end

        if not bobber then
            status.Text = "Status: Bobber not found"
            dlog("bobber tidak ketemu setelah cast")
            task.wait(0.5)
            continue
        end

        status.Text = "Status: Bobber detected!"
        local folder = getFolder()

        local reeled = false
        local connections = {}
        local watched = {}

        local function triggerReel(reason)
            if reeled or not isActive(myRun) then return end
            reeled = true
            status.Text = "Status: BITE! (" .. reason .. ")"
            dlog("BITE via " .. reason)
            task.spawn(click)
        end

        local function watchTug(obj)
            if watched[obj] then return end
            watched[obj] = true

            local function checkTug()
                if isTugging(obj:GetAttribute("Tug")) then
                    triggerReel("Tug")
                end
            end

            table.insert(connections,
                obj:GetAttributeChangedSignal("Tug"):Connect(checkTug)
            )

            table.insert(connections,
                obj.AttributeChanged:Connect(function(name)
                    dlog(string.format("AttributeChanged %s.%s = %s",
                        obj.Name, name, tostring(obj:GetAttribute(name))))
                end)
            )

            checkTug()
        end

        watchTug(bobber)

        for _, obj in ipairs(bobber:GetDescendants()) do
            watchTug(obj)
        end

        local anc = bobber.Parent
        while anc and anc ~= folder and anc ~= workspace do
            watchTug(anc)
            anc = anc.Parent
        end

        local waitStart = os.clock()
        local settleAt = waitStart + SETTLE_TIME
        local basePos = nil
        local lastDebug = 0

        while isActive(myRun) and bobber.Parent and not reeled
            and os.clock() - waitStart < reelTimeout do

            local now = os.clock()

            if now >= settleAt then
                if USE_MOVEMENT then
                    local pos = getPos(bobber)
                    if pos then
                        if not basePos then
                            basePos = pos
                        elseif (pos - basePos).Magnitude >= MOVE_THRESHOLD then
                            triggerReel("bobber bergeser")
                        end
                    end
                end

                if USE_FISH_PROXIMITY and not reeled then
                    local fish, dist = nearestFish(bobber, folder)
                    if fish and dist <= BITE_DISTANCE then
                        triggerReel("ikan dekat kail: " .. fish.Name)
                    end
                end
            end

            task.wait(0.05)
        end

        if isActive(myRun) and bobber.Parent and not reeled then
            status.Text = "Status: Timeout, recasting..."
        end

        local goneStart = os.clock()
        while isActive(myRun) and bobber.Parent
            and os.clock() - goneStart < goneTimeout do
            task.wait(0.1)
        end

        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end

        if isActive(myRun) then
            status.Text = "Status: Next Fishing..."
            task.wait(0.3)
        end
    end

    if runId == myRun then
        status.Text = "Status: OFF"
    end
end

