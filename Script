local function argsToString(...)
    local parts = {}
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        local s = typeof(v) == "Instance" and v:GetFullName() or tostring(v)
        if #s > 80 then
            s = s:sub(1, 80) .. "..."
        end
        parts[#parts + 1] = typeof(v) .. ":" .. s
    end
    return table.concat(parts, ", ")
end

