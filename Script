-- Dragging GUI
do
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = frame.Position
        end
    end)
    table.insert(uiConnections, UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(uiConnections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

gui.Destroying:Connect(function()
    running = false 
    runId = runId + 1
    for _, c in ipairs(uiConnections) do c:Disconnect() end
end)

-- ===== Simulator Tap Layar =====
local function insideFrame(x, y)
    local p, s = frame.AbsolutePosition, frame.AbsoluteSize
    return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function tapScreen()
    local cam = workspace.CurrentCamera
    local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
    
    local tx, ty = vs.X * 0.5, vs.Y * 0.5
    if insideFrame(tx, ty) then
        tx = vs.X * 0.5
        ty = vs.Y * 0.25
    end

    local touchId = 9
    pcall(function()
        VIM:SendTouchEvent(touchId, 0, tx, ty) 
        task.wait(clickDelay)
        VIM:SendTouchEvent(touchId, 2, tx, ty) 
    end)
end

-- Mendapatkan tool pancing yang sedang dipegang pemain
local function getFishingRod()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

-- ===== Loop Utama Deteksi Perubahan =====
local function fishingLoop(myRun)
    while isActive(myRun) do
        status.Text = "Status: Melempar Kail..."
        tapScreen() -- Lempar pancingan
        
        status.Text = "Status: Memantau Perubahan Game..."
        local waitStart = os.clock()
        local fishBited = false
        local toolConn = nil
        
        local rod = getFishingRod()
        if rod then
            -- Pantau jika ada Attribute yang berubah pada tool pancing (seperti sinyal 'Tug', 'Hooked', dll)
            toolConn = rod.AttributeChanged:Connect(function(attrName)
                local val = rod:GetAttribute(attrName)
                -- Jika ada perubahan atribut yang bernilai true atau angka aktif
                if val == true or (typeof(val) == "number" and val > 0) then
                    fishBited = true
                end
            end)
            
            -- Pantau juga jika ada perubahan nilai properti pada tool
            table.insert(uiConnections, rod.Changed:Connect(function(prop)
                if prop == "Parent" and rod.Parent == nil then
                    fishBited = true
                end
            end))
        end
        
        -- Tunggu sampai ikan menyambar atau terkena timeout
        while isActive(myRun) and not fishBited and (os.clock() - waitStart < maxWaitTime) do
            -- Cek cadangan: jika tool pancing tiba-tiba lepas atau berubah status
            local currentRod = getFishingRod()
            if not currentRod or currentRod ~= rod then
                fishBited = true
                break
            end
            task.wait(0.05)
        end
        
        if toolConn then toolConn:Disconnect() end
        
        if not isActive(myRun) then break end
        
        status.Text = "Status: STRIKE! Menarik Kail..."
        tapScreen() -- Tarik pancingan
        
        task.wait(postReelWait)
    end
    
    if runId == myRun then
        status.Text = "Status: OFF"
    end
end

-- ===== Tombol Kontrol =====
startButton.MouseButton1Click:Connect(function()
    if running then return end
    runId = runId + 1
    running = true
    status.Text = "Status: Berjalan"
    task.spawn(fishingLoop, runId)
end)

stopButton.MouseButton1Click:Connect(function()
    running = false
    runId = runId + 1
    status.Text = "Status: STOPPED"
end)
