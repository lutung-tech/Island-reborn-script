local clickDelay = 0.15          -- Lama tombol layar ditahan saat klik
local sinkThreshold = 0.8        -- Seberapa jauh (dalam stud) pelampung harus turun ke bawah untuk dianggap ditarik ikan
local maxWaitTime = 25           -- Maksimal tunggu ikan menyambar sebelum lempar ulang
local postReelWait = 1.5         -- Jeda setelah narik ikan sebelum lempar lagi

-- Hapus GUI lama agar bersih
pcall(function()
    local old = playerGui:FindFirstChild("IslandAutoFish")
    if old then old:Destroy() end
end)

