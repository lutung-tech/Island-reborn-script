-- AUTO FISHING - ISLAND REBORN (v8: Ultra Safe Delay & Smart Bite Detection)
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer

-- ===== Config =====
local clickDelay = 0.15        -- Lama tombol ditahan
local castTimeout = 10         -- Toleransi waktu lempar
local biteTimeout = 45         -- Maksimal tunggu ikan
local settleDelay = 4.5        -- Jeda aman agar kail benar-benar tenang & animasi lempar selesai
local postReelWait = 2.0       -- Jeda setelah narik ikan

-- ===== Parent GUI =====
local function getGuiParent()
    local ok, result = pcall(function()
        return (gethui and gethui()) or CoreGui
    end)
    if ok and result then return result end
    return player:WaitForChild("PlayerGui")
end

local guiParent = getGuiParent()

pcall(function()
    local old = guiParent:FindFirstChild("IslandAutoFish")
    if old then old:Destroy() end
end)

local running = false
local runId = 0 
local uiConnections = {}

local function isActive(id)
    return running and runId == id
end

-- ===== GUI =====
