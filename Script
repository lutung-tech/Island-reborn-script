-- Fungsi klik
local function click()
    local pos = UIS:GetMouseLocation()
    VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
    task.wait(clickDelay)
    VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
end

-- Cari folder Bobber
local function getFolder()
    return workspace:FindFirstChild("FishingBobbers")
end

-- Cari Bobber berdasarkan Attribute Tug atau nama
local function findBobber()
    local folder = getFolder()
    if not folder then return nil end

    for _, obj in ipairs(folder:GetDescendants()) do
        local hasTug = obj:GetAttribute("Tug") ~= nil
        local bobberName =
            obj.Name:lower():find("bobber") ~= nil

        if hasTug or (bobberName and obj:IsA("BasePart")) then
            return obj
        end
    end

    return nil
end

-- Tunggu Bobber tanpa retry terlalu cepat
local function waitForBobber()
    local start = os.clock()

    while running and os.clock() - start < bobberTimeout do
        local bobber = findBobber()

        if bobber then
            return bobber
        end

        task.wait(0.1)
    end

    return nil
end

local function isTugging(value)
    if value == true then
        return true
    end

    if typeof(value) == "number" and value > 0 then
        return true
    end

    return false
end

-- Proses auto fishing
local function fishingLoop()
    while running do
        status.Text = "Status: Casting..."
        click()

        status.Text = "Status: Searching Bobber..."

        local bobber = waitForBobber()

        if not running then break end

        if not bobber then
            status.Text = "Status: Bobber not found"
            task.wait(0.5)
            continue
        end

        status.Text = "Status: Bobber detected!"

        local reeled = false
        local connections = {}

        local function watchTug(obj)
            local function checkTug()
                if not running or reeled then return end

                local value = obj:GetAttribute("Tug")

                if isTugging(value) then
                    reeled = true
                    status.Text = "Status: TUG! REELING!"
                    click()
                end
            end

            table.insert(connections,
                obj:GetAttributeChangedSignal("Tug"):Connect(checkTug)
            )

            checkTug()
        end

        -- Pantau Bobber dan objek turunannya
        watchTug(bobber)

        for _, obj in ipairs(bobber:GetDescendants()) do
            if obj:GetAttribute("Tug") ~= nil then
                watchTug(obj)
            end
        end

        -- Tunggu Bobber hilang atau proses dihentikan
        while running and bobber.Parent and not reeled do
            task.wait(0.05)
        end

        -- Tunggu Bobber hilang setelah reel
        while running and bobber.Parent do
            task.wait(0.1)
        end

        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end

        if running then
            status.Text = "Status: Next Fishing..."
            task.wait(0.3)
        end
    end

    status.Text = "Status: OFF"
end

startButton.MouseButton1Click:Connect(function()
    if running then return end

    running = true
    status.Text = "Status: Starting..."

    task.spawn(fishingLoop)
end)

stopButton.MouseButton1Click:Connect(function()
    running = false
    status.Text = "Status: STOPPED"
end)
