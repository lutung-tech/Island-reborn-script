stopButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
stopButton.TextColor3 = Color3.new(1, 1, 1)
stopButton.Font = Enum.Font.GothamBold
stopButton.Parent = frame

-- Dragging GUI
do
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = frame.Position
        end
    end)
    table.insert(uiConnections, UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(uiConnections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

gui.Destroying:Connect(function()
    running = false 
    runId = runId + 1
    for _, c in ipairs(uiConnections) do c:Disconnect() end
end)

-- ===== Simulator Tap Layar =====
local function insideFrame(x, y)
    local p, s = frame.AbsolutePosition, frame.AbsoluteSize
    return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function tapScreen()
    local cam = workspace.CurrentCamera
    local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
    
    local tx, ty = vs.X * 0.5, vs.Y * 0.5
    if insideFrame(tx, ty) then
        tx = vs.X * 0.5
        ty = vs.Y * 0.25
    end

    local touchId = 9
    pcall(function()
        VIM:SendTouchEvent(touchId, 0, tx, ty) 
        task.wait(clickDelay)
        VIM:SendTouchEvent(touchId, 2, tx, ty) 
    end)
end

-- ===== Loop Utama Mancing =====
local function fishingLoop(myRun)
    while isActive(myRun) do
        status.Text = "Status: Melempar Kail..."
        tapScreen()
        
        -- Tahap 1: Tunggu kail masuk air
        status.Text = "Status: Menunggu Kail Masuk Air..."
        local terrain = workspace:WaitForChild("Terrain", 5)
        local emitter = nil
        local startWait = os.clock()
        
        while isActive(myRun) and (os.clock() - startWait < castTimeout) do
            if terrain then
                emitter = terrain:FindFirstChild("SoundEmitter")
                if emitter then break end
            end
            task.wait(0.1)
        end
        
        if not isActive(myRun) then break end
        
        if not emitter then
            status.Text = "Status: Kail Gagal, Mengulang..."
            task.wait(1)
            continue
        end
        
        -- Tahap 2: Settle Delay (Wajib agar cipratan awal lemparan terlewati)
        status.Text = "Status: Menunggu Kail Tenang..."
        local settleStart = os.clock()
        while isActive(myRun) and (os.clock() - settleStart < settleDelay) do
            task.wait(0.05)
        end
        
        if not isActive(myRun) then break end
        
        status.Text = "Status: Menunggu Ikan Menyambar..."
        
        -- Tahap 3: Deteksi suara sambaran yang valid
        local fishBited = false
        local biteConnection = nil
        
        biteConnection = emitter.ChildAdded:Connect(function(child)
            if child:IsA("Sound") then
                local sName = child.Name:lower()
                -- Cetak ke F9/Console game untuk memantau nama suara jika diperlukan
                print("[AutoFish Sound]:", sName)
                
                -- Kata kunci suara yang biasanya menandakan ikan menyambar atau kail ditarik
                if sName:find("bite") or sName:find("hook") or sName:find("catch") or sName:find("reel") or sName:find("success") or (sName ~= "fishing_rod_splash" and not sName:find("cast")) then
                    fishBited = true
                end
            end
        end)
        
        local biteStart = os.clock()
        while isActive(myRun) and not fishBited and (os.clock() - biteStart < biteTimeout) do
            if not emitter.Parent then break end
            task.wait(0.05)
        end
        
        if biteConnection then biteConnection:Disconnect() end
        
        if not isActive(myRun) then break end
        
        -- Tahap 4: Eksekusi
        if fishBited then
            status.Text = "Status: STRIKE! Narik Ikan..."
            tapScreen()
            task.wait(postReelWait)
        else
            status.Text = "Status: Timeout, Mengulang..."
            tapScreen()
            task.wait(1.5)
        end
    end
    
    if runId == myRun then
        status.Text = "Status: OFF"
    end
end

-- ===== Tombol =====
startButton.MouseButton1Click:Connect(function()
    if running then return end
    runId = runId + 1
    running = true
    task.spawn(fishingLoop, runId)
end)

stopButton.MouseButton1Click:Connect(function()
    running = false
    runId = runId + 1
    status.Text = "Status: STOPPED"
end)
