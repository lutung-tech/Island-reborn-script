-- Auto Fish Loop untuk Islands Reborn / Game Sejenis
getgenv().AutoFishing = true

task.spawn(function()
    print("[AutoFish] Berjalan...")
    while getgenv().AutoFishing do
        pcall(function()
            local player = game:GetService("Players").LocalPlayer
            local char = player.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    -- 1. Klik sekali untuk melempar kail
                    tool:Activate()
                    
                    -- 2. Waktu tunggu sampai ikan menyambar (Sesuaikan durasi ini jika kurang pas, misal 3.5 atau 4 detik)
                    task.wait(7)
                    
                    -- 3. Klik sekali lagi untuk menarik ikan ke inventory
                    tool:Activate()
                end
            end
        end)
        
        -- Jeda antar siklus lemparan pancing baru
        task.wait(1.5)
    end
    print("[AutoFishing] Berhenti.")
end)
